FROM node:20-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
# Accept Vite build-time env vars as Docker build args.
# These are BUNDLED into the frontend JavaScript — they are NOT runtime secrets.
# VITE_API_KEY is suitable for development/demo only.
ARG VITE_API_BASE_URL=
ARG VITE_API_KEY=
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_API_KEY=$VITE_API_KEY
RUN npm run build

FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
