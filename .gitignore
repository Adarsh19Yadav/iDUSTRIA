# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/
.env
.env.*
!.env.example

# ── ML artifacts (tracked by DVC, not Git) ────────────────────────────────────
ml/artifacts/*.pkl
ml/artifacts/*.joblib
ml/artifacts/*.json
ml/artifacts/*.model
!ml/artifacts/.gitkeep

# ── Data (raw data not committed) ─────────────────────────────────────────────
data/raw/*.csv
data/raw/*.zip
data/processed/*.parquet
!data/raw/.gitkeep
!data/processed/.gitkeep

# ── Vector store ──────────────────────────────────────────────────────────────
backend/chroma_db/

# ── Testing / Coverage ────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.lcov

# ── Mypy ──────────────────────────────────────────────────────────────────────
.mypy_cache/
.dmypy.json

# ── Ruff ──────────────────────────────────────────────────────────────────────
.ruff_cache/

# ── Node / Frontend ───────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/settings.json
.idea/

# ── Docker ────────────────────────────────────────────────────────────────────
docker-compose.override.yml

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
ml/notebooks/*.ipynb

# ── MkDocs ────────────────────────────────────────────────────────────────────
site/
