# ─────────────────────────────────────────────────────────────────────────────
# INDUSTRIA-X — Environment Variable Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development          # development | staging | production
APP_SECRET_KEY=change-me-to-a-long-random-string

# API_KEY — backend X-API-Key authentication
# All consequential write/compute endpoints require this header: X-API-Key: <value>
# Change this to a strong random value in any shared or internet-accessible environment.
API_KEY=change-me-to-a-secure-api-key

CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://industria:industria_pass@localhost:5432/industria_x
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── LLM Provider (watsonx.ai preferred; OpenAI-compatible fallback) ───────────
LLM_PROVIDER=watsonx          # watsonx | openai
# watsonx
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-13b-instruct-v2
# OpenAI fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── ChromaDB ─────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./backend/chroma_db

# ── Frontend (Vite build-time variables) ─────────────────────────────────────
# WARNING: VITE_* variables are BUNDLED into the frontend JavaScript bundle.
# They are NOT suitable for production secrets.
# VITE_API_KEY below is acceptable ONLY for a development/demo environment
# where all parties are trusted and the key is not sensitive.
# Never bundle real database, LLM, or sensitive API credentials into the frontend.
VITE_API_BASE_URL=http://localhost:8000
# VITE_API_KEY=change-me-to-a-secure-api-key   # matches API_KEY above; dev/demo only

# ── Sensor Simulation ────────────────────────────────────────────────────────
SENSOR_STREAM_INTERVAL_SECONDS=2
SENSOR_DATASET_PATH=./data/processed/sensor_stream.parquet

# ── ML ────────────────────────────────────────────────────────────────────────
ML_ARTIFACTS_DIR=./ml/artifacts
ACTIVE_FAILURE_MODEL=random_forest   # logistic_regression | random_forest | xgboost
ANOMALY_THRESHOLD=0.5
FAILURE_PROBABILITY_ALERT_THRESHOLD=0.6
RISK_SCORE_ALERT_THRESHOLD=70

# ── Phase 8: Persistence & Observability ─────────────────────────────────────
# Rate limiting (requests per client per window, applied to agent + assess endpoints)
# When Redis is unavailable, limits are bypassed gracefully (app stays usable).
RATE_LIMIT_AGENT_PER_MINUTE=30
RATE_LIMIT_ASSESS_PER_MINUTE=60
RATE_LIMIT_WINDOW_SECONDS=60

# ── Phase 7: Agentic AI ───────────────────────────────────────────────────────
# LLM_PROVIDER selects the provider used for optional LLM-augmented intent
# classification.  When credentials are absent the agent falls back to
# the built-in deterministic orchestrator — no LLM is required.
#
# watsonx.ai (IBM Granite — preferred)
# WATSONX_API_KEY and WATSONX_PROJECT_ID must be set to activate watsonx.
# WATSONX_API_KEY=
# WATSONX_PROJECT_ID=
# WATSONX_URL=https://us-south.ml.cloud.ibm.com
# WATSONX_MODEL_ID=ibm/granite-13b-instruct-v2
#
# OpenAI-compatible fallback
# OPENAI_API_KEY must be set to activate OpenAI.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
